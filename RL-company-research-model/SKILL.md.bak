        'sell_exp': -2.35, 'admin_exp': -7.26, 'rd_exp': -2.58,
        'fin_exp': -1.00, 'op_profit': 10.09, 'tax': 1.98,
        'np': 8.05, 'np_attr': 8.88, 'eps': 1.04,
        # CF
